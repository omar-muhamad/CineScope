{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth/[...all]?__ba_path=/api/auth/:path*"
    },
    {
      "source": "/api/saved/:listType/:mediaType/:mediaId",
      "destination": "/api/saved?listType=:listType&mediaType=:mediaType&mediaId=:mediaId"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
