# ── Client (Vite inlines every VITE_* var into the browser bundle) ──────────

# TMDB v4 API Read Access Token (Bearer). Get it from TMDB → Settings → API →
# "API Read Access Token" — a long JWT, NOT the old v3 api_key. Catalog reads
# only; safe to ship in the client bundle.
VITE_TMDB_READ_TOKEN=

# OMDb API key — used for the IMDb rating in the details view.
VITE_APP_OMDB_API_KEY=

# Google OAuth **web** client ID (Google Cloud Console → APIs & Services →
# Credentials → OAuth client ID). Add http://localhost:5173 to "Authorized
# JavaScript origins" for dev. Public by design — it identifies the app, not a
# secret. The API server reuses this value to verify Google ID tokens.
VITE_GOOGLE_CLIENT_ID=

# ── Server (server/ only — NEVER prefix these with VITE_) ───────────────────

# Postgres connection string (Neon/Railway/local). Used by the API server and
# by drizzle-kit migrations (npm run db:migrate). Direct (non-pooled) URLs are
# preferred; pooled URLs (Neon "-pooler" hosts, Supabase ?pgbouncer=true) are
# detected and get prepared statements disabled automatically.
DATABASE_URL=

# Secret for signing access tokens (HS256). Generate: openssl rand -hex 32
JWT_SECRET=

# Optional overrides (defaults shown):
# PORT=3001
# APP_ORIGIN=http://localhost:5173        # used to build email links
# ACCESS_TOKEN_TTL_SECONDS=900            # 15 minutes
# REFRESH_TOKEN_TTL_DAYS=30
# VERIFICATION_TOKEN_TTL_HOURS=24
# PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# GOOGLE_CLIENT_ID=                       # falls back to VITE_GOOGLE_CLIENT_ID

# SMTP transport for verification emails (Nodemailer). Leave SMTP_HOST empty
# in dev to print verification links to the server console instead of sending.
# Deliverability: MAIL_FROM must be an address the SMTP server is allowed to
# send as (for Gmail SMTP: the Gmail account itself) — a From-domain that
# fails SPF/DKIM alignment lands in spam. Defaults to SMTP_USER when unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
