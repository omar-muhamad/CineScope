# ── Client (Vite inlines every VITE_* var into the browser bundle) ──────────

# TMDB v4 API Read Access Token (Bearer). Get it from TMDB → Settings → API →
# "API Read Access Token" — a long JWT, NOT the old v3 api_key. Catalog reads
# only; safe to ship in the client bundle.
VITE_TMDB_READ_TOKEN=

# OMDb API key — used for the IMDb rating in the details view.
VITE_APP_OMDB_API_KEY=

# ── Server (api/ + server/ only — NEVER prefix these with VITE_) ────────────

# Postgres connection string — MUST be Neon's POOLER endpoint (the host with
# a `-pooler` suffix, from the Neon dashboard's "Pooled connection" toggle):
# Vercel runs many function instances concurrently and the direct endpoint's
# connection cap can't absorb that. Keep ?sslmode=require.
DATABASE_URL=

# Direct (unpooled) Neon endpoint — used only by drizzle-kit migrations
# (npm run db:migrate). Optional; falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Better Auth signing secret. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The origin the browser sees — magic-link URLs and the Google redirect_uri
# derive from it. Local dev (`npm run dev` = vercel dev) is port 3000; in the
# Vercel dashboard set the deployed https URL. Unset on preview deployments
# (falls back to VERCEL_URL — magic link works there, Google doesn't).
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth **web** client (Google Cloud Console → APIs & Services →
# Credentials). Add these "Authorized redirect URIs" to the client:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-prod-domain>/api/auth/callback/google
# Leave the secret empty to disable Google sign-in (magic link still works).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP transport for magic-link / email-change mail (Nodemailer). Leave
# SMTP_HOST empty in dev to print the links to the terminal instead of
# sending. Deliverability: MAIL_FROM must be an address the SMTP server is
# allowed to send as (for Gmail SMTP: the Gmail account itself) — a From
# domain that fails SPF/DKIM alignment lands in spam. Defaults to SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
